# Server environment only; never use VITE_ for credentials. Export variables before starting Node.
# SEARXNG_URL: SearXNG origin with JSON search enabled.
SEARXNG_URL=
# COMPOSIO_API_KEY: server credential, or use the private env file below.
COMPOSIO_API_KEY=
# PROMETH_COMPOSIO_ENV: explicit path to a private COMPOSIO_API_KEY env file.
# In development only, defaults to ~/.config/prometh/composio.env.
PROMETH_COMPOSIO_ENV=
# PROMETH_SESSION_SECRET: persistent random HMAC secret, required in production unless a fixed user is used.
PROMETH_SESSION_SECRET=
# COMPOSIO_USER_ID: optional fixed identity for local/single-user installations.
# Leave unset for signed per-browser identities. Never accept a client-supplied user id.
COMPOSIO_USER_ID=
# PORT: backend listening port (default 8787).
PORT=
# NODE_ENV: set to production with npm start (disables implicit secret-file fallback).
NODE_ENV=
